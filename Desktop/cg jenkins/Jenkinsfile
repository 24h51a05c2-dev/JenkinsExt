pipeline { agent any

stages {

    stage('Checkout') {
        steps {
            git branch: 'master',
                url: 'https://github.com/24h51a05c2-dev/javapipeline.git'
        }
    }

    stage('Build and Test') {
        steps {
            dir('JavaApp') {
                bat 'mvn clean test'
            }
        }
    }

    stage('Package') {
        steps {
            dir('JavaApp') {
                bat 'mvn package'
            }
        }
    }

    stage('Execute') {
        steps {
            dir('JavaApp') {
                bat 'java -cp target/classes com.example.App'
            }
        }
    }
}

post {
    success {
        echo 'Pipeline executed successfully!'
    }

    failure {
        echo 'Pipeline failed!'
    }
}


}