pipeline { agent any

stages {

    stage('Checkout') {
        steps {
            git branch: 'master',
    url: 'https://github.com/24h51a05c2-dev/javapipeline.git'
        }
    }

    stage('Build and Test') {
        steps {
            bat 'mvn clean test'
        }
    }

    stage('Package') {
        steps {
            bat 'mvn package'
        }
    }

    stage('Execute') {
        steps {
            bat 'java -cp target/classes com.example.App'
        }
    }
}


}